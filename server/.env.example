# Server Port
PORT=4000
JWT_SECRET=super_secret_luma_jwt_key_2026

# Option A: Free Cloud PostgreSQL (Supabase / Neon)
# Copy your connection string from Supabase (Settings > Database > Connection URI) or Neon
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Option B: Free Cloud Redis (Upstash)
# Copy your rediss:// connection string from Upstash Console (Details > Node.js)
REDIS_URL=rediss://default:your-upstash-password@your-endpoint.upstash.io:6379

# (Optional) Local Database fallback if not using Cloud URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=luma_db
# REDIS_HOST=localhost
# REDIS_PORT=6379
